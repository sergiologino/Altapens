# Публичный URL лендинга (канонический origin для Open Graph и sitemap)
NEXT_PUBLIC_SITE_URL=https://altapens.ru

# Куда ведёт кнопка «Открыть приложение» — SPA на поддомене (не корень лендинга).
NEXT_PUBLIC_APP_URL=https://app.altapens.ru

# --- Обязательно DNS для app.altapens.ru ---
# Браузер «сервер не найден / опечатка в имени» = имя app не резолвится или не тот IP.
# В панели DNS (регистратор, Cloudflare и т.д.) добавьте запись для поддомена app:
#   Тип A,  имя/хост: app   (или app.altapens.ru — как требует панель)
#   Значение: тот же IPv4, что у записи для корня altapens.ru (или @).
# Либо AAAA, если сайт только на IPv6. CNAME на apex часто нельзя — тогда только A.
# После сохранения подождите TTL (минуты…часы), проверьте: nslookup app.altapens.ru
# В Coolify домен app.altapens.ru должен быть привязан к тому же compose, что и веб (Traefik).

# Яндекс.Метрика (счётчик по умолчанию 108547150, если не задано)
# NEXT_PUBLIC_YANDEX_METRIKA_ID=108547150
# Локально без отправки хитов: NEXT_PUBLIC_YANDEX_METRIKA_DISABLED=true

# Опционально: верификация поисковиков
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
