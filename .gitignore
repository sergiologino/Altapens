# --- AltaPens (монорепозиторий: npm workspaces + Spring/Gradle) ---

# Зависимости
node_modules/

# Python
**/__pycache__/
*.py[cod]

# Переменные окружения и секреты (шаблоны *.example не игнорируем)
.env
.env.*
!.env.example

# Сборка фронтенда (Vite)
dist/
dist-ssr/
*.tsbuildinfo
.vite/

# Сборка и кэш Gradle / JVM (backend)
apps/backend/build/
apps/backend/.gradle/
apps/backend/bin/
**/out/
**/*.class

# Локальные env с секретами (шаблон — env_backend.example.txt)
apps/backend/env_backend.txt
apps/backend/.env

# Тесты и покрытие
coverage/
.nyc_output/

# Логи
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# macOS / Windows
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Редакторы и временные файлы
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln

# Локальный дистрибутив Gradle (сборка через Gradle Wrapper в apps/backend)
tools/gradle-*/
tools/gradle-*-bin.zip

# Прочее
.turbo/
*.pid
